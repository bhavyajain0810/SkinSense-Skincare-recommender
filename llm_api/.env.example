# Environment for the local LLM API server

# Backend selection: mock | ollama | openai
LLM_BACKEND=mock

# --- Mock backend (default) ---
# No extra settings required. The server returns a deterministic skincare routine.

# --- Ollama backend (optional) ---
#OLLAMA_BASE_URL=http://host.docker.internal:11434
#OLLAMA_MODEL=llama3.1

# --- OpenAI-compatible backend (optional) ---
#OPENAI_BASE_URL=https://api.openai.com
#OPENAI_API_KEY=sk-...

